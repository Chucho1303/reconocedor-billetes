# Copia este archivo como ".env" y ajusta los valores. ".env" esta en .gitignore
# y jamas debe subirse a Git. En produccion define estas variables en el
# servidor / contenedor (docker compose, secretos de GitHub, etc.), no en el codigo.

# Umbral minimo de similitud (0 a 1) para aceptar un billete
BILLETES_UMBRAL=0.35

# Carpeta alterna de plantillas (opcional; por defecto Back/plantillas)
# BILLETES_PLANTILLAS=/datos/plantillas

# Tamano maximo de imagen subida en MB
BILLETES_MAX_UPLOAD_MB=10

# Datos del equipo mostrados en la pestana "Acerca del proyecto" (separados por ;)
BILLETES_EQUIPO=Nombre Integrante 1;Nombre Integrante 2;Nombre Integrante 3
BILLETES_GRUPO=
